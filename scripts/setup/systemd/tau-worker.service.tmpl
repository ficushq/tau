# Rendered by scripts/setup/setup-host.sh — do not edit the installed copy by
# hand; re-run setup-host.sh (or edit this template) instead.
[Unit]
Description=Tau agent worker
Wants=network-online.target
After=network-online.target@DB_AFTER@

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@RUN_ROOT@/apps/core
EnvironmentFile=@DEST@/.env
# Platform-managed fleet-wide credentials (SES send creds, ...). The leading
# `-` makes it OPTIONAL: existing tenants and non-platform installs have no
# such file and are unaffected. Listed AFTER .env so a managed key wins on any
# collision. Written whole by the hosted platform's artifact sync — the
# tenant's own .env is never edited.
EnvironmentFile=-/etc/tau/managed.env
# The tree core reads config, migrations and the web dist from: the ACTIVE
# release (<dest>/current) in artifact mode, the checkout in git mode. Note
# systemd applies EnvironmentFile= AFTER Environment= regardless of the order
# these lines appear in, so a FICUS_ROOT in <dest>/.env would override this one
# and detach the running code from its own tree — setup-host.sh refuses a
# FICUS_ROOT coming through core.env for exactly that reason.
Environment=FICUS_ROOT=@RUN_ROOT@
Environment=PATH=@BUN_DIR@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=@BUN_BIN@ run dist/worker.js
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
# Logs: journalctl -u tau-worker -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
